# Copie este arquivo para .env e preencha os valores

SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=cafecookies
DB_USER=postgres
DB_PASSWORD=senha_do_postgres
DB_HOST=localhost
DB_PORT=5432
# Supabase/Neon exigem SSL (require). Local: prefer
DB_SSLMODE=prefer

# True para o Django servir as imagens enviadas (/media/) em produção, sem storage externo
SERVE_MEDIA=False

# --- Produção (Render) ---
# O Render preenche RENDER_EXTERNAL_HOSTNAME sozinho. Para domínio próprio:
# ALLOWED_HOSTS=meusite.com.br
# CSRF_TRUSTED_ORIGINS=https://meusite.com.br
# HTTPS=True ativa redirecionamento para https e cookies seguros
HTTPS=False

# Imagens no Supabase Storage. Deixe SUPABASE_PROJECT_REF vazio para salvar em media/ (local)
SUPABASE_PROJECT_REF=
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
